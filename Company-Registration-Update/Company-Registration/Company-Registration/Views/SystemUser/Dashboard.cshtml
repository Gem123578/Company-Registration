@{
    ViewBag.Title = "System User Dashboard";
    var userRole = Session["UserRole"]?.ToString();
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="~/Content/Index.css" rel="stylesheet" />
<h2>System User Dashboard</h2>

@*<div class="mb-3">
        <button class="btn btn-primary" onclick="openCreateUserModal()">+ Create User</button>
    </div>*@

<div id="systemUserContainer"
     data-grid-url="@Url.Action("SystemUserGrid","SystemUser")"
     data-create-url="@Url.Action("CreateUpdatePartial","SystemUser")"
     data-delete-url="@Url.Action("DeleteUser","SystemUser")">
    Loading users...
</div>

<!-- Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="userModalContent"></div>
    </div>
</div>

<!-- jQuery first -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script src="@Url.Content("~/Scripts/index.js")"></script>

<script>
    // Load users when page loads
    document.addEventListener("DOMContentLoaded", function () {
        loadSystemUsers();
    });
</script>
