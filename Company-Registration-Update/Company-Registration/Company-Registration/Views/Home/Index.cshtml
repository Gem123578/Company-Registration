@{
    Layout = null;
    ViewBag.Title = "Home Page";
    var userRole = Session["UserRole"]?.ToString();
}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewBag.Title</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/Index.css" rel="stylesheet" />
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: #c3dafe">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index","Home")">Company Portal</a>
            <div class="ms-auto">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Profile","SystemUser")">Profile</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("MyCompany","CompanyRegistration")">My Company</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="@Url.Action("Logout","CompanyApplicant")">Logout</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login","CompanyApplicant")" class="btn btn-outline-light me-2">Login</a>
                    <a href="@Url.Action("Register","CompanyApplicant")" class="btn btn-light">Sign Up</a>
                }
            </div>
        </div>
    </nav>

    <div class="page-center">
        <div class="wrapper">
            <h1>Company Registration Portal</h1>
            <h6 class="mb-4">Manage Your Company Registration Online</h6>

            <div class="row">
                <!-- LEFT MENU -->
                <div class="col-md-4 mb-3">
                    <button class="menu-btn active" onclick="showContent('home', this)">Home Info</button>
                    <button class="menu-btn active" onclick="showContent('register', this)">How to Register</button>

                    @* Re-register menu shown only for system users *@
                    @if (User.Identity.IsAuthenticated && (userRole != "APPLICANT"))
                    {
                        <button class="menu-btn" onclick="loadSystemUsers(this)">
                            Manage System User
                        </button>


                    }
                </div>

                <!-- RIGHT CONTENT -->
                <div class="col-md-8">
                    <!-- Home -->
                    <div id="home" class="content active">
                        <h5>Welcome!</h5>
                        <p class="info-text">This portal allows applicants to register new companies and manage registration online.</p>
                        <p class="info-text">You need an applicant account to register a company.</p>
                        <p class="info-text">Once logged in, fill in company details, shareholder info, and upload required documents.</p>
                        <p class="info-text">Please ensure all information is accurate before submission.</p>
                    </div>

                    <!-- Register -->
                    <div id="register" class="content">
                        <h5>Registration Steps</h5>
                        <div class="step-card"><h6>Step 1: Create Applicant Account</h6><p class="info-text">Sign up to become an official applicant.</p></div>
                        <div class="step-card"><h6>Step 2: Login</h6><p class="info-text">Access the portal using your account credentials.</p></div>
                        <div class="step-card"><h6>Step 3: Fill Company Details</h6><p class="info-text">Provide company name, type, address, business activity, and incorporation date.</p></div>
                        <div class="step-card"><h6>Step 4: Add Shareholders & Directors</h6><p class="info-text">Provide shareholder names, identity info, and share percentage.</p></div>
                        <div class="step-card"><h6>Step 5: Upload Documents</h6><p class="info-text">Upload identification, constitution, and other required files.</p></div>
                        <div class="step-card"><h6>Step 6: Submit for Review</h6><p class="info-text">Verify your data carefully before submission.</p></div>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a href="@Url.Action("Register", "CompanyRegistration")" class="btn btn-primary-custom mt-3">Start Registration</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Register", "CompanyApplicant")" class="btn btn-primary-custom mt-3">Sign Up to Register</a>
                        }
                    </div>
                    <div id="reregister" class="content">
                        <h5>System Users</h5>

                        <div id="systemUserContainer">
                            Loading users...
                        </div>
                    </div>

                    <div class="modal fade" id="userModal" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content" id="userModalContent"></div>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function showContent(id, btn) {
            ["home", "register", "reregister"].forEach(function (sec) {
                document.getElementById(sec).classList.remove("active");
            });
            document.getElementById(id).classList.add("active");

            document.querySelectorAll(".menu-btn").forEach(function (b) {
                b.classList.remove("active");
            });
            btn.classList.add("active");
        }

        function loadSystemUsers(btn) {
    ["home", "register", "reregister"].forEach(sec => {
        document.getElementById(sec).classList.remove("active");
    });

    document.getElementById("reregister").classList.add("active");

    document.querySelectorAll(".menu-btn").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");

    fetch('@Url.Action("SystemUserGrid", "SystemUser")')
        .then(res => res.text())
        .then(html => document.getElementById("systemUserContainer").innerHTML = html);
}

// Create User Modal
function openCreateUserModal() {
    fetch('@Url.Action("CreateUpdatePartial", "SystemUser")')
        .then(res => res.text())
        .then(html => showUserModal(html));
}

// Edit User Modal
function openEditUserModal(userId) {
    fetch('@Url.Action("CreateUpdatePartial", "SystemUser")?id=' + userId)
        .then(res => res.text())
        .then(html => showUserModal(html));
}

function showUserModal(html) {
    document.getElementById("userModalContent").innerHTML = html;
    var userModal = new bootstrap.Modal(document.getElementById('userModal'));
    userModal.show();

    // Bind form submit after modal content is loaded
    var form = document.getElementById("userForm");
    if (form) {
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            var formData = new FormData(form);
            fetch(form.action, { method: "POST", body: formData })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        userModal.hide();
                        loadSystemUsers(document.querySelector(".menu-btn.active"));
                    }
                });
        });
    }
        }
function deleteUser(id) {

    if (!confirm("Are you sure you want to delete this user?"))
        return;

    fetch('@Url.Action("DeleteUser", "SystemUser")?id=' + id, {
    method: 'POST'})

    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert(data.message);
        }
    });
}

    </script>
</body>
</html>
